{
  "name": "gomin-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:generate": "node scripts/generate-docs.mjs",
    "predev": "npm run docs:generate",
    "prebuild": "npm run docs:generate"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.1.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
