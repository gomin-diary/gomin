# Development: copy the API URL and Secret key from `npm run supabase:status`.
# Deployment: set the Supabase Cloud project URL and Secret key in Render.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Server-only key. Never expose it through NEXT_PUBLIC_ variables.
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Local HTTP only. Keep true in production HTTPS.
AUTH_COOKIE_SECURE=false

# Delivery implementation: resend (default) or smtp.
MAIL_PROVIDER=resend

# Resend HTTPS API. Required only when sending email; server-only configuration.
RESEND_API_KEY=
# Address on a domain verified in Resend; choose your owned domain/subdomain.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Gomin
RESEND_TIMEOUT_SECONDS=10

# Google SMTP. Credentials are required only when sending email.
SMTP_HOST=smtp.gmail.com
# 587: STARTTLS, 465: implicit TLS. Unencrypted connections are not supported.
SMTP_PORT=587
SMTP_USERNAME=
# Google app password, not your normal account password. Server-only secret.
SMTP_PASSWORD=
SMTP_FROM_NAME=Gomin
SMTP_TIMEOUT_SECONDS=10
