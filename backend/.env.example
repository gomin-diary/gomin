# Development: copy the API URL and Secret key from `npm run supabase:status`.
# Deployment: set the Supabase Cloud project URL and Secret key in Render.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Server-only key. Never expose it through NEXT_PUBLIC_ variables.
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# Existing Supabase Storage bucket for server-only uploads.
STORAGE_BUCKET=gomin-files
# Upload size limit checked against actual bytes (10 MiB).
STORAGE_MAX_FILE_SIZE_BYTES=10485760
# Private generated image bucket provisioned by the SQL migration.
DIARY_IMAGE_BUCKET=gomin-diary-images
DIARY_IMAGE_MAX_PIXELS=16777216

# Codyssey API: server-only virtual key; never use NEXT_PUBLIC_ for this key.
# Use the public HTTPS origin, without /v1 or /api/v1/images.
AI_BASE_URL=https://copa.codyssey.kr
AI_API_KEY=
AI_TEXT_MODEL=gpt-5.4-mini
# Configure a provider-supported image model explicitly; the supplied example
# uses gpt-image-1-mini. The text model is not an image-model fallback.
AI_IMAGE_MODEL=
# Provider URLs require a web login session; request image bytes as Base64.
AI_IMAGE_RESPONSE_FORMAT=b64_json
AI_TIMEOUT_SECONDS=120

# Delivery implementation: resend (default) or smtp.
MAIL_PROVIDER=resend

# Resend HTTPS API. Required only when sending email; server-only configuration.
RESEND_API_KEY=
# Address on a domain verified in Resend; choose your owned domain/subdomain.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Gomin
RESEND_TIMEOUT_SECONDS=10

# Google SMTP. Credentials are required only when sending email.
SMTP_HOST=smtp.gmail.com
# 587: STARTTLS, 465: implicit TLS. Unencrypted connections are not supported.
SMTP_PORT=587
SMTP_USERNAME=
# Google app password, not your normal account password. Server-only secret.
SMTP_PASSWORD=
SMTP_FROM_NAME=Gomin
SMTP_TIMEOUT_SECONDS=10

# Local HTTP only; use true in production HTTPS.
AUTH_COOKIE_SECURE=false

# Google OAuth web client. Optional until Google login is enabled; backend only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Register this exact callback URI in the Google Cloud OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
AUTH_FRONTEND_ORIGIN=http://127.0.0.1:3000
# Independent Fernet key (cryptography.fernet.Fernet.generate_key()); backend only.
AUTH_OAUTH_ENCRYPTION_KEY=

# Independent server-only random key, at least 32 bytes; required for signup email verification.
AUTH_HMAC_KEY=
# Development draft versions; replace together with the frontend legal documents.
AUTH_TERMS_VERSION=dev-2026-10-02
AUTH_PRIVACY_VERSION=dev-2026-10-02
